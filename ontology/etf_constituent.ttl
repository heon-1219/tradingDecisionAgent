# ============================================================================
# etf_constituent.ttl — domestic ETF holdings (v_etf_constituent) TBox
#
# Purpose
#   Documents the holdings as a structured table so that a query combining a relation and a number,
#   such as "삼성전자를 보유한 ETF 중 순자산 상위 3개" (top 3 ETFs holding 삼성전자 by net assets), is one SQL join.
#
# Why a separate view
#   Holdings are not in the organizers' four masters. They were collected from Naver Finance (1,162 domestic ETFs, 22,599 rows)
#   and used to live only in the knowledge graph. So the graph knew the relation and SQL knew the net assets,
#   nothing connected the two, and the agent invented a join that does not exist (a stock code put on
#   v_etf_kr.pd_ticker -> 0 rows). The cause was two places interpreting the same fact, so loading happens only in the ETL.
#
# Identity
#   company_code is the stock code the source provides (present on 79% of rows). 삼성전자 005930 and 삼성전자우 005935
#   are different stocks, told apart only by code. Rows without a code (foreign stocks, cash) use the name the
#   source published as their identity. Stocks are never merged by name similarity — doing so attributed 'LG' to
#   신한금융지주 and 'KT' to SK텔레콤, corrupting 677 rows.
#
# TBox / ABox
#   Also reflected in the graph as d:etf_kr/<ISIN> --fp:hasConstituent--> d:company/<id>.
#   The graph and this view are built from the same table, so their counts cannot diverge.
#
# Data characteristics (as_of 2026-09-03)
#   - is_cash=1 marks non-stock rows such as 원화현금 and 설정현금액. Filter on is_cash=0 when counting stocks.
#   - weight_pct is the weight (%); only each ETF's top holdings were collected, so the weights do not sum to 100%.
#   - Foreign ETFs (v_etf_gl) and public funds (v_fund_pub) have no holdings data.
# ============================================================================

@prefix fp:   <http://mafest.ai/product#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ----------------------------------------------------------------------------
# 1. Table class
# ----------------------------------------------------------------------------

fp:ETFHolding a owl:Class ;
    rdfs:label "ETF편입종목"@ko , "ETF holding"@en ;
    rdfs:comment "국내 ETF 한 종목이 편입한 개별 종목 한 건. 원천 네이버금융 → 뷰 v_etf_constituent. 기준일 2026-09-03."@ko ;
    fp:sourceTable "v_etf_constituent" ;
    fp:sourceId "naver_finance" .

# ----------------------------------------------------------------------------
# 2. Properties
# ----------------------------------------------------------------------------

fp:holdingEtfIsin a owl:DatatypeProperty ;
    rdfs:label "ETF 종목번호(ISIN)"@ko ;
    rdfs:comment "편입한 쪽 ETF 의 ISIN. v_etf_kr.pd_itm_no 와 조인하는 키."@ko ;
    rdfs:domain fp:ETFHolding ; rdfs:range xsd:string ;
    fp:sourceTable "v_etf_constituent" ; fp:sourceColumn "etf_itm_no" .

fp:holdingEtfTicker a owl:DatatypeProperty ;
    rdfs:label "ETF 단축코드"@ko ;
    rdfs:comment "편입한 쪽 ETF 의 6자리 단축코드."@ko ;
    rdfs:domain fp:ETFHolding ; rdfs:range xsd:string ;
    fp:sourceTable "v_etf_constituent" ; fp:sourceColumn "etf_ticker" .

fp:holdingEtfName a owl:DatatypeProperty ;
    rdfs:label "ETF 명"@ko ;
    rdfs:comment "편입한 쪽 ETF 의 약어명."@ko ;
    rdfs:domain fp:ETFHolding ; rdfs:range xsd:string ;
    fp:sourceTable "v_etf_constituent" ; fp:sourceColumn "etf_name" .

fp:holdingCompanyCode a owl:DatatypeProperty ;
    rdfs:label "편입종목 종목코드"@ko ;
    rdfs:comment "편입된 종목의 코드 (삼성전자 005930, 삼성전자우 005935). 전체의 79% 에 수록되며, 있으면 이 컬럼으로 지정하는 것이 가장 정확하다. 해외 종목·현금은 NULL."@ko ;
    rdfs:domain fp:ETFHolding ; rdfs:range xsd:string ;
    fp:sourceTable "v_etf_constituent" ; fp:sourceColumn "company_code" .

fp:holdingCompanyName a owl:DatatypeProperty ;
    rdfs:label "편입종목명"@ko ;
    rdfs:comment "출처가 게시한 종목명. 해외 종목은 한글 표기(예: '엔비디아', '마이크론 테크놀로지'). 코드가 없을 때의 신원."@ko ;
    rdfs:domain fp:ETFHolding ; rdfs:range xsd:string ;
    fp:sourceTable "v_etf_constituent" ; fp:sourceColumn "company_name" .

fp:holdingWeight a owl:DatatypeProperty ;
    rdfs:label "편입비중"@ko ;
    rdfs:comment "ETF 내 비중. 상위 종목만 수집되어 ETF 별 합계가 100% 에 못 미친다."@ko ;
    rdfs:domain fp:ETFHolding ; rdfs:range xsd:decimal ;
    fp:unit "%" ;
    fp:sourceTable "v_etf_constituent" ; fp:sourceColumn "weight_pct" .

fp:holdingIsCash a owl:DatatypeProperty ;
    rdfs:label "현금성 여부"@ko ;
    rdfs:comment "1 이면 원화현금·설정현금액 등 종목이 아닌 행. 종목을 세거나 나열할 때는 is_cash=0 을 건다."@ko ;
    rdfs:domain fp:ETFHolding ; rdfs:range xsd:boolean ;
    fp:sourceTable "v_etf_constituent" ; fp:sourceColumn "is_cash" .

fp:holdingAsOf a owl:DatatypeProperty ;
    rdfs:label "수집 기준일"@ko ;
    rdfs:comment "편입종목을 수집한 날짜. 상품 마스터 기준일(2026-08-21)과 다르므로 근거에 함께 밝힌다."@ko ;
    rdfs:domain fp:ETFHolding ; rdfs:range xsd:date ;
    fp:sourceTable "v_etf_constituent" ; fp:sourceColumn "as_of" .
