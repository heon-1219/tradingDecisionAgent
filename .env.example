# LLM provider: gemini (default) | anthropic | openai | stub
# The competition build used NCP HyperCLOVA X (an organizer rule); this English edition runs on Google Gemini.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash

# Google Gemini - create a key at https://aistudio.google.com/apikey (GOOGLE_API_KEY also works).
# A key set here is used ahead of a GEMINI_API_KEY exported in your shell.
GEMINI_API_KEY=
# Gemini's OpenAI-compatible endpoint; change it only if you go through a proxy
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# low | medium | high | xhigh | max  (sent to Gemini as reasoning_effort; xhigh/max map to high)
LLM_EFFORT=medium
LLM_MAX_TOKENS=8192          # includes Gemini's thinking tokens (rationale in config.py)
LLM_TIMEOUT_SEC=40

# Optional alternates
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_FALLBACKS=true
# OpenAI, or any other OpenAI-compatible server (vLLM, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Per-question budget. Kept from the competition: over 300 s counts as no answer; within it, late answers lose points.
TIME_BUDGET_SEC=120
MAX_TOOL_ROUNDS=8
SQL_ROW_LIMIT=200
SQL_TIMEOUT_SEC=5

# Vector index: lsa (offline TF-IDF+SVD, no key needed) | openai (embedding API) | off
VECTOR_BACKEND=lsa
VECTOR_DIMS=384
VECTOR_MAX_DF=0.005
VECTOR_EMBED_MODEL=text-embedding-3-small

# 429 (rate limit) handling. Free-tier keys allow only a few requests per minute.
RATE_LIMIT_RETRIES=4
# Minimum seconds between calls. 0 = wait only when the provider reports a nearly exhausted quota.
REQUEST_MIN_INTERVAL_SEC=0

# Paper-trading assistant (/api/* and the web app at /). Keys can also be saved from the app's
# Settings, which checks them against Alpaca's paper host first. The trading host is fixed to paper.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
TAVILY_API_KEY=
SEC_USER_AGENT=
TRADING_ENABLED=true
# /api/* answers only this computer. true lets other machines in: UNSAFE unless you put your own
# authentication in front (it can place paper orders and write keys into this file).
# The client address checked is the socket peer: run uvicorn with --no-proxy-headers (python -m
# finagent.api does), so X-Forwarded-For can never make a remote request look local.
# This file wins over variables exported in your shell; the environment only fills in what is
# missing or empty here (GET /api/settings lists those names as env_fallbacks). So the kill switch,
# which writes TRADING_ENABLED=false here, survives a restart whatever the shell exports.
API_ALLOW_REMOTE=false
