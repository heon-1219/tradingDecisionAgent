# LLM provider: anthropic | openai | stub
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
# low | medium | high | xhigh | max  (latency vs. depth; medium keeps most answers under 30s)
LLM_EFFORT=medium
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SEC=40

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_FALLBACKS=true

# OpenAI-compatible (OpenAI, Gemini OpenAI-compat, NCP CLOVA Studio, vLLM ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Per-question wall-clock budget (organizer recommends <= 60s)
TIME_BUDGET_SEC=50
MAX_TOOL_ROUNDS=6
SQL_ROW_LIMIT=200
SQL_TIMEOUT_SEC=5

# Vector index: lsa (offline TF-IDF+SVD, no key needed) | openai (embedding API) | off
VECTOR_BACKEND=lsa
VECTOR_DIMS=384
VECTOR_MAX_DF=0.005
VECTOR_EMBED_MODEL=text-embedding-3-small
