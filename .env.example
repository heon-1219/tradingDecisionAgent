# LLM provider. 대회 규정: 답변 생성 파이프라인은 NCP HyperCLOVA X 필수.
# clova | anthropic | openai | stub   (anthropic/openai 는 규정상 제출용으로 쓸 수 없음 — 개발 비교용)
LLM_PROVIDER=clova
LLM_MODEL=HCX-005

# NCP CLOVA Studio (OpenAI 호환 엔드포인트). 테스트앱/서비스앱 API 키를 넣습니다.
CLOVA_API_KEY=
CLOVA_BASE_URL=https://clovastudio.stream.ntruss.com/v1/openai
# low | medium | high | xhigh | max  (latency vs. depth; medium keeps most answers under 30s)
LLM_EFFORT=medium
LLM_MAX_TOKENS=1536          # 출력 상한. CLOVA function calling 은 1024 이상 필수 (근거는 config.py 주석)
LLM_TIMEOUT_SEC=40

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_FALLBACKS=true

# OpenAI-compatible (OpenAI, Gemini OpenAI-compat, NCP CLOVA Studio, vLLM ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 문항당 예산. 주최측: 300초 초과는 '미응답' 처리, 그 안이면 늦어도 채점되나 점수 차등.
TIME_BUDGET_SEC=120
MAX_TOOL_ROUNDS=8
SQL_ROW_LIMIT=200
SQL_TIMEOUT_SEC=5

# Vector index: lsa (offline TF-IDF+SVD, no key needed) | openai (embedding API) | off
VECTOR_BACKEND=lsa
VECTOR_DIMS=384
VECTOR_MAX_DF=0.005
VECTOR_EMBED_MODEL=text-embedding-3-small

# 429(요청 한도) 대응. CLOVA 는 QPM(요청)과 TPM(분당 토큰)을 따로 재며 둘 중 하나만 넘어도 429 다.
RATE_LIMIT_RETRIES=4
# 호출 사이 최소 간격(초). 0 이면 응답 헤더의 잔여 한도를 보고 필요할 때만 대기한다.
REQUEST_MIN_INTERVAL_SEC=0
