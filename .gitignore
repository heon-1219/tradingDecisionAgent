.venv/
__pycache__/
*.pyc
# Every env file (.env, .env.local, ...) and the env file's atomic-write temp files (..env.*.tmp);
# only the documented template is kept.
.env*
..env.*.tmp
!.env.example
data/store/
data/enrichment/constituents/.cache/
data/external/cache/
.pytest_cache/
*.log

# The tuning training set can be regenerated by script (the CSVs are large)
data/tuning/*.csv

# Server access keys — never commit (NCP auth keys, SSH keys)
*.pem
*.key
*.p12
id_rsa*
